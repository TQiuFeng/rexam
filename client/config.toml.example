# rexam 现场考试客户端配置。把本文件改名为 config.toml，放在 exe 同目录。
#
# 命令行参数会覆盖这里的同名项，装机脚本可以一台一条命令：
#   rexam-client.exe --server=https://exam.example.com --room-code=E86HDZ --seat-no=7 --lang=en

# 考试服务端地址。末尾有没有斜杠都行。
# 这一项填错整个考场都连不上，而且要等到开考那一刻才会有人发现，装机后务必起一次确认。
server = "http://127.0.0.1:8080"

# 锁定级别：
#   off   不锁。只在本机调试时用，正式考试绝不要用。
#   soft  免管理员：独占全屏 + 置顶 + 键盘钩子吞掉逃逸组合键 + 前台看门狗 + 多屏检测。
#   hard  soft 的全部，再加禁用任务管理器、进程黑名单巡检、禁用 U 盘存储。
#         后两项需要管理员权限；拿不到就只是少锁一项并上报，不会影响考试进行。
lock = "soft"

# 界面语言：zh 简体中文（默认）/ en English。
# 只影响客户端自己的文案；题干、选项、考生姓名一律按服务端下发的原样显示，
# 也就是说出的是中文卷子，界面设成 en 也还是中文题目。
lang = "zh"

# ---- 机位预置：「提前分好座位」就靠这两行 ----
# 装机时给每台机器写上本考场的考场码和这台机器的座位号，
# 客户端开机自己就去绑，考生坐下什么都不用做。
# 留空则客户端会弹一次绑定页，由监考老师现场输入。
room_code = ""
seat_no = 0

# 监考口令。强烈建议在正式考场里设上。
#
# 留空 = 考生交完卷屏幕就解锁、可以自己关掉客户端。
# 设了它 = 交卷后屏幕继续锁着，必须监考老师输入这个口令才能退出 ——
# 否则先交卷的考生会在别人还在考的时候回到桌面。
exit_password = ""

# ---- 下面这些一般不用改 ----

# 机位轮询间隔（秒）。服务端容量是按每台 3 秒估的，别往小了调。
poll_secs = 3

# 答案自动保存的静默期（毫秒）：停止输入这么久才发请求。
# 调太小会把简答题打成几十个请求，调太大则断电时丢的内容更多。
autosave_debounce_ms = 800

# 对时心跳间隔（秒）。倒计时一律以服务端时间为准，考场机器的本地时钟经常是歪的。
clock_secs = 15

# 硬锁巡检要结束的进程名（小写，带扩展名）。只在 lock = "hard" 时生效。
process_blacklist = [
    "qq.exe",
    "wechat.exe",
    "weixin.exe",
    "dingtalk.exe",
    "teamviewer.exe",
    "sunloginclient.exe",
    "todesk.exe",
    "anydesk.exe",
]

# 低配模式：关掉界面的抗锯齿羽化。
#
# 画面会锐一点（圆角边缘不那么平滑），但明显省力。
# 什么时候开：考场机器是没有独立显卡的老机器，或者通过远程桌面使用 ——
# 这两种情况下界面是纯软件绘制的，羽化产生的额外三角形是每帧开销的大头。
# 实测在这类机器上，开了之后界面构建的耗时降到原来的三分之一。
# 机器正常就不用开，圆角会更好看。
low_graphics = false
