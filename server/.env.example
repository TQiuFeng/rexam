# 复制为 .env 后修改
DATABASE_URL=postgres://rexam:rexam@127.0.0.1:5432/rexam
REDIS_URL=redis://127.0.0.1:6379/0
BIND_ADDR=0.0.0.0:8080

# 生产环境务必换成长随机串
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12

# 首次启动且 users 表为空时自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 数据库连接池大小（每个 API 节点）
DB_MAX_CONNS=20
# 答案从 Redis 刷入 PostgreSQL 的周期与每轮批量
FLUSH_INTERVAL_SECS=3
FLUSH_BATCH=200
# 超过截止时间多少秒后仍接受保存（网络抖动宽限）
DEADLINE_GRACE_SECS=30

# 允许跨域的前端域名，逗号分隔。开发期用 * 即可；
# 生产环境请填前端的实际地址，例如 https://exam.example.com
CORS_ALLOW_ORIGINS=*
# 单个请求体上限（MB）。批量导入几千道题会比较大，默认 16
MAX_BODY_MB=16

# 机位绑定的防滥用设置。拿到考场码的人如果能提前把全场座位占满，
# 考试当天真实机器会全部绑不上，而他手里那批凭证到点还能换来考生的登录 token。
# 同一 IP 对同一考场码每分钟最多绑几次（人工逐台布机远达不到这个速度）
SEAT_BIND_LIMIT_PER_MIN=30
# 开考前多少小时开始允许绑定机位（再早一律拒绝）
SEAT_BIND_LEAD_HOURS=24

# AI 判卷（简答题、规则判分未满分的填空题）。任意 OpenAI 兼容接口均可：
#   DeepSeek： AI_BASE_URL=https://api.deepseek.com/v1                         AI_MODEL=deepseek-chat
#   通义千问： AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1    AI_MODEL=qwen-plus
# 关闭或不填 key 时，主观题全部留给教师批改
AI_GRADING_ENABLED=false
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECS=60
AI_MAX_RETRIES=3

RUST_LOG=info,sqlx=warn
